<Window x:Class="WPF_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WPF_Project.ViewModels"
        xmlns:views="clr-namespace:WPF_Project.Views"
        Title="Robot Cleaner"
    Width="1280"
    Height="800"
    MinWidth="1100"
    MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- MapViewModel과 MapView 연결 -->
        <DataTemplate DataType="{x:Type vm:MapViewModel}">
            <views:MapView/>
        </DataTemplate>

            <!-- TODO(6): DashboardViewModel과 DashboardView의 DataTemplate을 추가하세요. -->
            <!-- TODO(7): PathViewModel과 PathView의 DataTemplate을 추가하세요. -->

    </Window.Resources>

    <Grid>
        <!-- 현재 ViewModel에 해당하는 View 표시 -->
        <ContentControl Content="{Binding CurrentViewModel}"/>
    </Grid>

</Window>
