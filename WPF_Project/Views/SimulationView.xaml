<UserControl x:Class="WPF_Project.Views.SimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3E285B"/>
            <Setter Property="Background" Value="#F3EDF9"/>
            <Setter Property="BorderBrush" Value="#E2D5F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Surface"
                                    CornerRadius="11"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"/>
                            <Border x:Name="InteractionShade"
                                    CornerRadius="11"
                                    Background="#3E285B"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <StackPanel x:Name="Label"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextElement.Foreground="{TemplateBinding Foreground}">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <Border x:Name="FocusRing"
                                    Margin="3"
                                    CornerRadius="8"
                                    BorderBrush="{TemplateBinding Foreground}"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#F3F0F5"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#EBE4EE"/>
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="#6F6578"/>
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="388" Background="#FFF7FA" Padding="18">
        <Border Padding="11"
                Background="White"
                BorderBrush="#EADFF0"
                BorderThickness="1"
                CornerRadius="16">
            <StackPanel>
                <UniformGrid Rows="2" Columns="2">
                    <Button Content="시작" Tag="▶" Command="{Binding StartCommand}"
                            Background="#614296" BorderBrush="#614296" Foreground="White"
                            ToolTip="남은 경로를 따라 이동"/>
                    <Button Content="정지" Tag="■" Command="{Binding StopCommand}"
                            Background="#FAE6EE" BorderBrush="#F2D4E0" Foreground="#72384F"
                            ToolTip="현재 칸에서 정지"/>
                    <Button Content="초기화" Tag="↺" Command="{Binding ResetCommand}"
                            ToolTip="출발 칸으로 돌아가기"/>
                    <Button Content="다음" Tag="→" Command="{Binding NextCommand}"
                            ToolTip="경로를 따라 한 칸 이동"/>
                </UniformGrid>

                <Border Background="#FFF3F6"
                        BorderBrush="#F2DCE5"
                        BorderThickness="1"
                        CornerRadius="9"
                        Margin="5,7,5,5"
                        Padding="10,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Simulation.HasPath}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="이동할 경로가 없습니다. 맵을 다시 생성해 주세요."
                               Foreground="#634257" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
