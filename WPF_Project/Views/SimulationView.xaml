<UserControl x:Class="WPF_Project.Views.SimulationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<StackPanel Orientation="Horizontal">
		<Button Content="시작" Command="{Binding StartCommand}" />
		<Button Content="일시정지" Command="{Binding PauseCommand}" />
		<Button Content="재개" Command="{Binding ResumeCommand}" />
		<Button Content="초기화" Command="{Binding ResetCommand}" />
	</StackPanel>
</UserControl>
