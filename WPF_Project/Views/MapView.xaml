<UserControl x:Class="WPF_Project.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="RobotVisibility"/>
        <BitmapImage x:Key="RobotIcon"
                     UriSource="pack://application:,,,/WPF_Project;component/Assets/RobotVacuum.png"/>
        <Style x:Key="MapTile" TargetType="Border">
            <Setter Property="Background" Value="{Binding CellColor}"/>
            <Setter Property="BorderBrush" Value="#E4DEE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CellType}" Value="Empty">
                    <Setter Property="Background" Value="#FFFDF8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CellType}" Value="Obstacle">
                    <Setter Property="Background" Value="#DAD2E3"/>
                    <Setter Property="BorderBrush" Value="#C9BED4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CellType}" Value="Start">
                    <Setter Property="Background" Value="#D6EFE3"/>
                    <Setter Property="BorderBrush" Value="#AEDAC5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CellType}" Value="End">
                    <Setter Property="Background" Value="#E9DEF7"/>
                    <Setter Property="BorderBrush" Value="#D4BFEA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasRobot}" Value="True">
                    <Setter Property="BorderBrush" Value="#614296"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MapTileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#494055"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRobot}" Value="True">
                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFF7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 맵 제목 -->
        <TextBlock Grid.Row="0"
                   Text="Robot Cleaner Map"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   Margin="15"/>

        <!-- 7x7 맵 -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Cells}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="7" Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="55" Height="55" Margin="2"
                            Style="{StaticResource MapTile}">
                        <Grid>
                            <Image Source="{StaticResource RobotIcon}"
                                   Width="36" Height="34" Margin="0,1,0,0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="로봇 현재 위치"
                                   ToolTip="로봇 현재 위치"
                                   Visibility="{Binding HasRobot, Converter={StaticResource RobotVisibility}}"/>
                            <TextBlock Text="{Binding CellType}"
                                       Style="{StaticResource MapTileLabel}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- 하단 버튼 패널 -->
        <Grid Grid.Row="2"
              Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 맵 초기화 -->
            <Button Grid.Column="0"
                    Content="Reset Map"
                    Command="{Binding ResetCommand}"
                    Background="#F6C5D0"
                    Foreground="#555555"
                    FontWeight="Bold"
                    FontSize="14"
                    Height="45"
                    Margin="5"
                    BorderThickness="0"/>

            <!-- 대시보드 -->
            <Button Grid.Column="1"
                    Content="Dashboard"
                    Command="{Binding DashboardCommand}"
                    Background="#C8E6C9"
                    Foreground="#555555"
                    FontWeight="Bold"
                    FontSize="14"
                    Height="45"
                    Margin="5"
                    BorderThickness="0"/>

            <!-- 로봇 움직이기 -->
            <Button Grid.Column="2"
                    Content="Move Robot"
                    Command="{Binding MoveRobotCommand}"
                    Background="#D8C8F0"
                    Foreground="#555555"
                    FontWeight="Bold"
                    FontSize="14"
                    Height="45"
                    Margin="5"
                    BorderThickness="0"/>

        </Grid>

    </Grid>
</UserControl>
