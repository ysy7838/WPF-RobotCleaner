<UserControl x:Class="WPF_Project.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPF_Project.ViewModels">

    <!--<UserControl.DataContext>
        <vm:MapViewModel />
    </UserControl.DataContext>-->

    <Grid Background="#FFF7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 맵 제목 -->
        <TextBlock Grid.Row="0"
                   Text="Robot Cleaner Map"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#555555"
                   HorizontalAlignment="Center"
                   Margin="15"/>

        <!-- 7x7 맵 -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Cells}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="7" Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="55"
                            Height="55"
                            Background="{Binding CellColor}"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Margin="2">

                        <TextBlock Text="{Binding CellType}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#333333"/>

                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- 하단 버튼 패널 -->
        <Grid Grid.Row="2"
              Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 맵 초기화 -->
            <Button Grid.Column="0"
                    Content="Reset Map"
                    Command="{Binding ResetCommand}"
                    Background="#F6C5D0"
                    Foreground="#555555"
                    FontWeight="Bold"
                    FontSize="14"
                    Height="45"
                    Margin="5"
                    BorderThickness="0"/>

            <!-- 대시보드 -->
            <Button Grid.Column="1"
                    Content="Dashboard"
                    Command="{Binding DashboardCommand}"
                    Background="#C8E6C9"
                    Foreground="#555555"
                    FontWeight="Bold"
                    FontSize="14"
                    Height="45"
                    Margin="5"
                    BorderThickness="0"/>

            <!-- 로봇 움직이기 -->
            <Button Grid.Column="2"
                    Content="Move Robot"
                    Command="{Binding MoveRobotCommand}"
                    Background="#D8C8F0"
                    Foreground="#555555"
                    FontWeight="Bold"
                    FontSize="14"
                    Height="45"
                    Margin="5"
                    BorderThickness="0"/>

        </Grid>

    </Grid>
</UserControl>
