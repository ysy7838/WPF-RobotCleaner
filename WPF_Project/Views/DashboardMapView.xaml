<UserControl x:Class="WPF_Project.Views.DashboardMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Malgun Gothic" Foreground="#1B2C43" Background="#F3F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24,28,8,28">
            <TextBlock Text="ROBOT CLEANER MAP" Foreground="#137B68" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="청소 맵" FontSize="28" FontWeight="Bold" Margin="0,6,0,20" />
            <Border Background="White" CornerRadius="14" BorderBrush="#DFE6EE" BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding Position, StringFormat=현재 위치 {0}}" FontWeight="Bold" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding MapCells}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding MapRows}" Columns="{Binding MapColumns}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="44" Height="44" Margin="2" CornerRadius="5" BorderThickness="1"
                                        ToolTip="{Binding Coordinates}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F4F7FA" />
                                            <Setter Property="BorderBrush" Value="#D5DFE8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCleaned}" Value="True">
                                                    <Setter Property="Background" Value="#DDF4EB" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsRobot}" Value="True">
                                                    <Setter Property="Background" Value="#137B68" />
                                                    <Setter Property="BorderBrush" Value="#137B68" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="10" />
                                                <Setter Property="Text" Value="{Binding Coordinates}" />
                                                <Setter Property="Foreground" Value="#53667C" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRobot}" Value="True">
                                                        <Setter Property="Text" Value="R" />
                                                        <Setter Property="FontSize" Value="20" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MapDescription}" TextWrapping="Wrap" FontSize="12"
                               Foreground="#53667C" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
